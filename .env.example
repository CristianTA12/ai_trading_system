# ============================================
# AI Trading System — Environment Variables
# ============================================
# Copiar a .env y rellenar con valores reales
# NUNCA commitear el archivo .env al repositorio
# ============================================

# === Database ===
POSTGRES_USER=trading
POSTGRES_PASSWORD=CHANGE_ME_secure_password
POSTGRES_DB=trading_db
DATABASE_URL=postgresql://trading:CHANGE_ME_secure_password@localhost:5432/trading_db

# === Redis ===
REDIS_URL=redis://localhost:6379/0

# === Data directory (Ubuntu SSD 2TB) ===
DATA_DIR=/data

# === Exchange API Keys ===
# Binance
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true

# === MLflow ===
MLFLOW_TRACKING_URI=http://localhost:5000

# === Grafana ===
GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGE_ME_grafana_password

# === Ollama (LLM Local) ===
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b

# === Telegram Alerts ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === Trading Parameters ===
TRADING_SYMBOL=BTC/USDT
TRADING_TIMEFRAME=15m
TRADING_MODE=paper

# === Risk Management ===
MAX_RISK_PER_TRADE=0.01
MAX_POSITION_SIZE=0.20
MAX_DAILY_LOSS=0.02
MAX_DRAWDOWN=0.10
MAX_LEVERAGE=3
MIN_CONFIDENCE=0.65

# === Logging ===
LOG_LEVEL=INFO
LOG_DIR=/data/logs
